# Copie ce fichier en ".env" UNIQUEMENT pour un usage local (docker compose up
# en développement). Pour un déploiement via Portainer, NE PAS committer de
# ".env" dans le dépôt Git : Portainer détectera ces variables et proposera
# de les renseigner dans son formulaire de déploiement, ce qui est plus sûr.

# --- Base de données ---
POSTGRES_USER=genealogy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=genealogy

# --- Sécurité ---
# Génère une valeur aléatoire avec : openssl rand -hex 32
JWT_SECRET=change-me

# --- Compte administrateur créé automatiquement au premier démarrage ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FULL_NAME=Administrateur

# --- Réseau / exposition ---
# Nom d'un réseau Docker existant (ex. celui de ton reverse proxy) auquel
# le frontend sera rattaché pour être exposé.
NETWORK_NAME=proxy

# Port publié en plus, pour un accès direct sans reverse proxy (optionnel).
PUBLISHED_PORT=8091
